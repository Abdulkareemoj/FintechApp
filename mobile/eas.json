{
  "cli": {
		"version": ">= 20.0.0"
  },
  "build": {
    "development": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "http://YOUR-ORACLE-BACKEND-IP:5182/api"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "http://YOUR-ORACLE-BACKEND-IP:5182/api"
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      },
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "http://YOUR-ORACLE-BACKEND-IP:5182/api"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
