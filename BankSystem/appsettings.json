{
  "ConnectionStrings": {
  "DefaultConnection": "Data Source=(localdb)\\MSSQLLocalDB;Initial Catalog=fintech;Integrated Security=True;TrustServerCertificate=True;MultipleActiveResultSets=true;"
},
  "Jwt": {
    "Key": "your-super-secret-key-minimum-32-characters-long-change-this-in-production!",
    "Issuer": "FinTechAPI",
    "Audience": "FinTechClient",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Information",
        "Hangfire": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/fintech-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "Encryption": {
    "Key": "your-32-character-encryption-key"
  },
  "AllowedHosts": "*",

  "App": {
    "FrontendUrl": "http://localhost:3000"
  },
  "Email": {
    "Provider": "SendGrid",
    "SendGridApiKey": "your-sendgrid-api-key",
    "FromEmail": "noreply@fintech.com",
    "FromName": "FinTech"
  }
}
