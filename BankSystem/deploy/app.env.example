# systemd EnvironmentFile — copy to ~/fintech-backend/shared/app.env on the server.
# The deploy script sources this same file before running the migration bundle,
# so ConnectionStrings__DefaultConnection is used by BOTH the app and efbundle.
#
# Values override appsettings.json via the __ (double underscore) nesting syntax.

# --- Runtime ---
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://0.0.0.0:5182

# --- Database (SQL Server reachable from this instance) ---
# Used by the app and by ./efbundle --connection during deploys.
ConnectionStrings__DefaultConnection="Data Source=<host>,1433;Initial Catalog=fintech;User ID=<user>;Password=<password>;TrustServerCertificate=True;MultipleActiveResultSets=true;"

# --- Auth (replace both keys with long random secrets) ---
Jwt__Key="REPLACE-ME-with-a-random-64-plus-character-secret"
Jwt__Issuer=FinTechAPI
Jwt__Audience=FinTechClient
Jwt__AccessTokenExpirationMinutes=15
Jwt__RefreshTokenExpirationDays=7

Encryption__Key="REPLACE-ME-32-characters-exact"

# --- CORS / links ---
# Your Vercel URL, e.g. https://fintech-web.vercel.app
App__FrontendUrl=https://your-web-app.vercel.app

# --- Email (EmailService is currently a stub, but wire it when it ships) ---
Email__Provider=SendGrid
Email__SendGridApiKey="SG.REPLACE-ME"
Email__FromEmail=noreply@yourdomain.com
Email__FromName=FinTech
