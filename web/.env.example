# Web app API base URL — read by src/lib/apiClient.ts (import.meta.env.VITE_API_BASE_URL).
# Copied to .env.local for local dev (never commit .env.local).
#
# Local dev  → http://localhost:5182
# Vercel prod → set VITE_API_BASE_URL in the Vercel dashboard (Project → Settings
#               → Environment Variables) to your backend origin, e.g.
#               http://YOUR-ORACLE-BACKEND-IP:5182
#               Vite inlines it at build time. The backend must allow your Vercel
#               origin via App__FrontendUrl in its app.env (CORS).
VITE_API_BASE_URL=http://localhost:5182
